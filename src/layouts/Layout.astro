---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "WolfxFilms · Cinematic Video for Founders, Podcasts & Brands",
  description = "Cinematic video production for founders, podcasts and brands in Medellín, Colombia. Directed by Carlos Jimenez."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/img/hero.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/img/hero.jpg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&display=swap"
    />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "WolfxFilms",
        "description": "Cinematic video production for founders, podcasts and brands in Medellín, Colombia.",
        "founder": {
          "@type": "Person",
          "name": "Carlos Jimenez",
          "jobTitle": "Director / DP"
        },
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Medellín",
          "addressCountry": "CO"
        },
        "sameAs": [
          "https://www.instagram.com/wolfxfilms/"
        ]
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
