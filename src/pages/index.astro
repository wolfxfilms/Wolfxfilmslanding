---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import Hero from '../components/Hero';
import Stats from '../components/Stats';
import ComparisonSlider from '../components/ComparisonSlider';
import SelectedWork from '../components/SelectedWork';
import Testimonials from '../components/Testimonials';
import TwoAngles from '../components/TwoAngles';
import HowItWorks from '../components/HowItWorks';
import SetGallery from '../components/SetGallery';
import Pricing from '../components/Pricing';
import TargetAudience from '../components/TargetAudience';
import AboutDirector from '../components/AboutDirector';
import FAQ from '../components/FAQ';
import BookingBox from '../components/BookingBox';
import Footer from '../components/Footer';
---

<Layout>
  <Navbar client:load />
  <main id="page">
    <Hero client:load />
    <Stats client:visible />
    <ComparisonSlider client:visible />
    <SelectedWork client:visible />
    <Testimonials client:visible />
    <TwoAngles client:visible />
    <HowItWorks client:visible />
    <SetGallery client:visible />
    <Pricing client:visible />
    <TargetAudience client:visible />
    <AboutDirector client:visible />
    <FAQ client:visible />
    <BookingBox client:visible />
  </main>
  <Footer client:visible />
</Layout>
